diff --git a/UEFI/include/ConvertPtr.h b/UEFI/include/ConvertPtr.h
new file mode 100644
index 0000000..8e00ebe
--- /dev/null
+++ b/UEFI/include/ConvertPtr.h
@@ -0,0 +1,99 @@
+/**
+ * ConvertPtr.h  (UEFI side)  —  v6 pointer graph conversion
+ * =================================================================
+ * Converts every RUNTIME-ASSIGNED pointer in the driver to the OS
+ * virtual address space, from inside the
+ * EVT_SIGNAL_VIRTUAL_ADDRESS_CHANGE event (which the OS fires by
+ * calling SetVirtualAddressMap, BEFORE the firmware rewrites the gRT
+ * function slots — verified empirically in the sandbox forensics,
+ * "order B").
+ *
+ * Why this is needed:
+ *   - Our image is a runtime driver: the firmware re-applies its ELF
+ *     relocations at SetVirtualAddressMap, which fixes LINK-TIME
+ *     pointers only.
+ *   - Pointers assigned at RUNTIME (instance_ = &obj, handler_->pool_,
+ *     saved original gRT services, gnu-efi's ST/RT variables...) are
+ *     NOT relocations. If left physical they dereference garbage once
+ *     the OS page tables take over → #PF inside a kernel-called hook.
+ *
+ * Ordering rule (CRITICAL):
+ *   All conversions go through the CURRENT (physical) value of
+ *   gRT->ConvertPointer captured ONCE at entry. The RT/ST variables
+ *   themselves are converted LAST, and nothing may dereference gRT /
+ *   gST inside this file after that point (during the event the new
+ *   virtual addresses are not mapped yet — they only become valid
+ *   when the OS loader switches page tables AFTER SetVirtualAddressMap
+ *   returns).
+ * =================================================================
+ */
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+#include <efi.h>
+#include <efilib.h>
+#ifdef __cplusplus
+}
+#endif
+
+#include "SerialTrace.h"
+#include "Diag.h"
+#include "PhysicalMemory.h"
+#include "ProcessMemory.h"
+#include "ProcessFinder.h"
+#include "SharedMemoryPool.h"
+#include "RequestHandler.h"
+#include "RuntimeHook.h"
+#include "CR3Capture.h"
+
+namespace UEFIBridge {
+
+// Everything the VA event handler needs a handle on.
+// (CvtOne lives in Diag.h to avoid a circular include.)
+struct ConvertGraph {
+    PhysicalMemory*   pm;
+    SharedMemoryPool* pool;
+    ProcessMemory*    pmem;
+    ProcessFinder*    finder;
+    RequestHandler*   handler;
+    RuntimeHook*      rthook;
+    CR3Capture*       cr3;
+};
+
+// Convert the whole runtime-assigned pointer graph.
+// Called ONLY from the VA-change event handler.
+inline VOID ConvertPointersAll(ConvertGraph* g) {
+    SerialTrace::Line("VA", "ConvertPointers: begin");
+
+    // Physical ConvertPointer — still valid during the event (order B).
+    EFI_CONVERT_POINTER cvt = gRT->ConvertPointer;
+
+    if (g) {
+        if (g->rthook)  g->rthook->ConvertSelf(cvt);
+        if (g->handler) g->handler->ConvertSelf(cvt);
+        if (g->finder)  g->finder->ConvertSelf(cvt);
+        if (g->pmem)    g->pmem->ConvertSelf(cvt);
+        if (g->pool)    g->pool->ConvertSelf(cvt);
+        // PhysicalMemory: uefi_cr3_ / os_cr3_ are CR3 *values* — they
+        // must stay physical (the CR3 register takes physical roots).
+
+        // Static instance pointers used by post-boot hooks.
+        CvtOne(cvt, (VOID**)&RuntimeHook::instance_, "RuntimeHook::instance_");
+
+        // CR3Capture internals are only used inside the EBS callback,
+        // which still runs on the loader's identity-mapped tables —
+        // deliberately NOT converted.
+    }
+
+    // LAST: gnu-efi's table pointer variables (ST/RT live inside our
+    // image, extern "C", see efilib.h). BS is dead after EBS — skip.
+    CvtOne(cvt, (VOID**)&RT, "RT");
+    CvtOne(cvt, (VOID**)&ST, "ST");
+
+    DiagSetFlag(kDiagFlagVirtual);
+    SerialTrace::Line("VA", "ConvertPointers: done");
+}
+
+} // namespace UEFIBridge
diff --git a/UEFI/include/Diag.h b/UEFI/include/Diag.h
new file mode 100644
index 0000000..79b9449
--- /dev/null
+++ b/UEFI/include/Diag.h
@@ -0,0 +1,186 @@
+/**
+ * Diag.h  (UEFI side)  —  INFDIAG v8
+ * =================================================================
+ * The INFDIAG non-volatile variable under our vendor GUID
+ * {A1B2C3D4-E5F6-4789-9ABC-DEF012345678}. Size is EXACTLY 32 bytes
+ * (dmpstore shows DataSize = 0x20).
+ *
+ * Stage ladder (same semantics as v5/v6/v7):
+ *   1 = driver loaded OK (pool + request handler + EBS hook installed)
+ *   2 = ExitBootServices FIRED  (os_cr3 + win_build captured)
+ *   3 = RT build: VA-change event complete (pointers converted)
+ *   4 = RT build: Windows CALLED a hooked service in VIRTUAL mode
+ *
+ * Field layout (little endian):
+ *   0x00 u32 magic       'DFNI' bytes 44 46 4E 49  (0x494E4644)
+ *   0x04 u32 stage       see ladder above
+ *   0x08 u32 flags       see kDiagFlag* below (v8 semantics)
+ *   0x0C u32 win_build   NtBuildNumber from KUSER_SHARED_DATA, 0=unknown
+ *   0x10 u64 os_cr3      CR3 captured at ExitBootServices
+ *   0x18 u32 hook_calls  how many hooked-service calls we serviced
+ *   0x1C u32 last_status EFI_STATUS of the last INFDIAG SetVariable
+ *
+ * v8 changes:
+ *   - flags bits 3..6 defined (bit3 was used by v7 already):
+ *       bit3 = gRT hooks installed EARLY at load time (pre-snapshot)
+ *       bit4 = first virtual-mode hook call SEEN (stage 4 live)
+ *       bit5 = a trigger variable write (InfinityReq/INFTRIGGER)
+ *              was serviced from the OS
+ *       bit6 = final DiagWrite done from the ResetSystem hook
+ *   - DiagWrite() calls the ORIGINAL SetVariable directly
+ *     (g_diag_orig_setvar, captured by RuntimeHook::InstallEarly and
+ *     converted at the VA event) instead of gRT->SetVariable — in
+ *     the RT build the live slot is our own hook; the direct orig
+ *     call removes the round-trip and the re-entrancy window.
+ *   - Print order: the full line EXCEPT " st=" prints BEFORE the
+ *     SetVariable call, " st=0x.." AFTER — so a death inside the
+ *     write still leaves the complete pre-write trace in the log.
+ */
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+#include <efi.h>
+#include <efilib.h>
+#ifdef __cplusplus
+}
+#endif
+
+#include <cstdint>
+
+#include "SerialTrace.h"
+
+namespace UEFIBridge {
+
+// Defined in main.c (inside this namespace — R3 fix).
+extern EFI_GUID gInfinityMemVarGuid;
+
+#pragma pack(push, 1)
+struct InfinityDiag {
+    UINT32 magic;
+    UINT32 stage;
+    UINT32 flags;
+    UINT32 win_build;
+    UINT64 os_cr3;
+    UINT32 hook_calls;
+    UINT32 last_status;
+};
+#pragma pack(pop)
+
+static_assert(sizeof(InfinityDiag) == 32, "INFDIAG must remain exactly 32 bytes");
+
+enum : UINT32 {
+    kDiagStageLoaded         = 1,
+    kDiagStageEbsFired       = 2,
+    kDiagStageHooksInstalled = 3,
+    kDiagStageHookCalled     = 4,
+};
+
+enum : UINT32 {
+    kDiagFlagLoaded      = 0x1, // stage 1 written
+    kDiagFlagEbsFired    = 0x2, // ExitBootServices hook ran
+    kDiagFlagVirtual     = 0x4, // VA event + pointer conversion done
+    kDiagFlagEarlyHooks  = 0x8, // v8 (v7-compatible): hooks in gRT at load
+    kDiagFlagHookLive    = 0x10, // first VIRTUAL-mode hook call seen
+    kDiagFlagTriggerSeen = 0x20, // OS wrote a trigger variable to us
+    kDiagFlagResetPersist= 0x40, // final DiagWrite from ResetSystem hook
+};
+
+// Runtime-updated mirror of the variable. Written from any mode; the
+// serial trace on every write is what makes failures visible.
+inline UINT32 g_diag_stage       = 0;
+inline UINT32 g_diag_flags       = 0;
+inline UINT32 g_diag_win_build   = 0;
+inline UINT64 g_diag_os_cr3      = 0;
+inline UINT32 g_diag_hook_calls  = 0;
+inline UINT32 g_diag_last_status = 0;
+
+// Re-entrancy guard kept for belt-and-braces: v8 DiagWrite no
+// longer goes through the hooked slot, but any future code path
+// that calls gRT->SetVariable while a hook is installed must set
+// this first (the hook passes busy callers to the original).
+inline UINT32 g_diag_busy = 0;
+
+// v8: the ORIGINAL (un-hooked) SetVariable, captured by
+// RuntimeHook::InstallEarly() at load time and converted to its
+// virtual address at the VA-change event. Null in the SAFE build —
+// DiagWrite then uses the live gRT slot (which is never hooked).
+inline EFI_SET_VARIABLE g_diag_orig_setvar = nullptr;
+
+// Write the current snapshot to INFDIAG. Safe at load time (physical
+// gRT), inside the VA event (gRT slots still physical — v5 proved
+// this works), at EBS (RT mapped both ways) and from the gRT hooks
+// post-boot (orig pointer converted by ConvertPointers).
+//
+// v8: goes through g_diag_orig_setvar (the ORIGINAL firmware
+// SetVariable) — NOT the live gRT slot, which in the RT build is our
+// own HookedSetVariable.
+inline VOID DiagWrite() {
+    InfinityDiag d;
+    d.magic       = 0x494E4644;
+    d.stage       = g_diag_stage;
+    d.flags       = g_diag_flags;
+    d.win_build   = g_diag_win_build;
+    d.os_cr3      = g_diag_os_cr3;
+    d.hook_calls  = g_diag_hook_calls;
+    d.last_status = g_diag_last_status; // previous write's status
+
+    UINT32 prev_status = g_diag_last_status;
+
+    // v8: full line EXCEPT the status prints BEFORE the write; a
+    // crash inside the write still leaves the complete trace.
+    SerialTrace::Begin("DIAG");
+    SerialTrace::Puts("write stage=");
+    SerialTrace::Dec(g_diag_stage);
+    SerialTrace::Puts(" flags=0x");
+    SerialTrace::Hex32(g_diag_flags);
+    SerialTrace::Puts(" prev_st=0x");
+    SerialTrace::Hex32(prev_status);
+    SerialTrace::Puts(" st=0x");
+
+    g_diag_busy = 1;
+    // v8: call the ORIGINAL SetVariable directly (RT build) — the
+    // live gRT slot holds our own hook; the orig pointer was
+    // captured at load and converted at the VA event. SAFE build:
+    // the slot is the untouched firmware pointer.
+    EFI_SET_VARIABLE sv = g_diag_orig_setvar
+        ? g_diag_orig_setvar
+        : gRT->SetVariable;
+    EFI_STATUS s = sv(
+        (CHAR16*)L"INFDIAG", &gInfinityMemVarGuid,
+        EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS |
+            EFI_VARIABLE_RUNTIME_ACCESS,
+        sizeof(d), &d);
+    g_diag_busy = 0;
+
+    g_diag_last_status = (UINT32)s;
+    SerialTrace::Hex32((UINT32)s);
+}
+
+inline VOID DiagSetStage(UINT32 stage) { g_diag_stage = stage; }
+inline VOID DiagSetFlag(UINT32 flag)   { g_diag_flags |= flag; }
+
+// Convert one runtime-assigned pointer via the ConvertPointer service.
+// Defined here (not in ConvertPtr.h) so RuntimeHook::ConvertSelf can
+// use it without a circular include.
+inline VOID CvtOne(EFI_CONVERT_POINTER cvt, VOID** pp, const char* tag) {
+    if (!pp || !*pp) {
+        SerialTrace::Begin("CVT");
+        SerialTrace::Puts(tag);
+        SerialTrace::Puts(" (null, skip)");
+        return;
+    }
+    UINT64 before = (UINT64)*pp;
+    EFI_STATUS s = cvt(0, pp);
+    SerialTrace::Begin("CVT");
+    SerialTrace::Puts(tag);
+    SerialTrace::Puts(" 0x");
+    SerialTrace::Hex64(before);
+    SerialTrace::Puts(" -> 0x");
+    SerialTrace::Hex64((UINT64)*pp);
+    SerialTrace::Puts(" st=0x");
+    SerialTrace::Hex32((UINT32)s);
+}
